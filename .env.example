# DeerFlow Mini — Environment Variables
# Copy to .env and fill in your values

# ── LLM Provider (OpenAI-compatible) ──────────────────────────────────────────
# For vLLM / Ollama / LiteLLM / any OpenAI-compatible endpoint:
OPENAI_API_KEY=your-api-key


# ── Web Search ────────────────────────────────────────────────────────────────
# SearXNG is used when available (Docker production). DuckDuckGo is fallback.
SEARXNG_BASE_URL=http://searxng:8080

# ── Optional ──────────────────────────────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000
# GITHUB_TOKEN=your-github-token

# ── Auth (auto-generated by deploy.sh, but can be set manually) ───────────────
# Required for multi-worker gateway. Without this, each worker generates
# its own JWT secret and tokens become invalid across workers.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_JWT_SECRET=your-jwt-secret
